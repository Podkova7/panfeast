---
import type { GetStaticPaths } from 'astro';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Pager from '../components/Pager.astro';
import AdSlot from '../components/AdSlot.astro';
import { allPosts } from '../lib/posts';
import { SITE } from '../consts';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await allPosts();
  return paginate(posts, { pageSize: SITE.postsPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const first = page.currentPage === 1;
const title = first
  ? `${SITE.name} - ${SITE.tagline}`
  : `Latest articles - page ${page.currentPage}`;
const description = first
  ? SITE.description
  : `Page ${page.currentPage} of iOS and Apple guides, tutorials, and reviews from ${SITE.name}.com.`;
---
<Base {title} {description} noindex={!first}>
  <div class="wrap">
    <div class="page-head">
      <h1>{first ? 'iOS and Apple Ecosystem, Explored in Depth' : `Latest articles - page ${page.currentPage}`}</h1>
      {first && <p>In-depth guides, optimization tutorials, and expert tips for iOS, iPhone, iPad, Mac, and Apple gear.</p>}
    </div>
    <div class="grid">
      {page.data.map((post, i) => <PostCard post={post} eager={i < 3} />)}
    </div>
    <AdSlot label="archive-footer" />
    <Pager {page} />
  </div>
</Base>
